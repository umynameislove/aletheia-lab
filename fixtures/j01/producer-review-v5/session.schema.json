{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "User Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "email": {
          "maxLength": 254,
          "minLength": 3,
          "title": "Email",
          "type": "string"
        },
        "email_verified": {
          "title": "Email Verified",
          "type": "boolean"
        }
      },
      "required": [
        "user_id",
        "display_name",
        "email",
        "email_verified"
      ],
      "title": "Actor",
      "type": "object"
    },
    "SessionInfo": {
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Context Id",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "context_id",
        "expires_at"
      ],
      "title": "SessionInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "product-api/v1-draft",
      "title": "Schema Version",
      "type": "string"
    },
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "session": {
      "$ref": "#/$defs/SessionInfo"
    },
    "csrf_token": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Csrf Token",
      "type": "string"
    },
    "onboarding": {
      "enum": [
        "ready",
        "needs_workspace"
      ],
      "title": "Onboarding",
      "type": "string"
    },
    "last_workspace_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Last Workspace Id"
    }
  },
  "required": [
    "schema_version",
    "actor",
    "session",
    "csrf_token",
    "onboarding",
    "last_workspace_id"
  ],
  "title": "Session",
  "type": "object"
}
