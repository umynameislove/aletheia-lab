{
  "$defs": {
    "ProductGraph": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/ProductGraphNode"
          },
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/ProductGraphEdge"
          },
          "title": "Edges",
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "title": "ProductGraph",
      "type": "object"
    },
    "ProductGraphEdge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Target",
          "type": "string"
        },
        "visibility": {
          "const": "diagnosis",
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "source",
        "target",
        "visibility"
      ],
      "title": "ProductGraphEdge",
      "type": "object"
    },
    "ProductGraphNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "visibility": {
          "const": "diagnosis",
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "source_id",
        "visibility"
      ],
      "title": "ProductGraphNode",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "product-api/v1-draft",
      "title": "Schema Version",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Workspace Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "result_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Result Id",
      "type": "string"
    },
    "graph": {
      "$ref": "#/$defs/ProductGraph"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    },
    "next_cursor": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    }
  },
  "required": [
    "schema_version",
    "workspace_id",
    "project_id",
    "result_id",
    "graph"
  ],
  "title": "GraphView",
  "type": "object"
}
