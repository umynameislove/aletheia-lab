  ],
  "findings": [
    {
      "code": "matched_model_and_generation_policy",
      "status": "pass",
      "evidence": "B1/B2/A1/A2/A3 retain one GPT-4.1 snapshot, decoding, output budget, timeout and retry ceiling."
    },
    {
      "code": "hidden_truth_and_evaluator_metadata_excluded",
      "status": "pass",
      "evidence": "Every registered information budget excludes hidden truth and evaluator metadata; web, shell and project execution are disabled."
    },
    {
      "code": "citation_ablation_transport_conflict",
      "status": "pass_forward_fix",
      "evidence": "The historical diagnosis-output/2 minItems=1 rule is preserved for prior work and superseded for the diagnosis main study by diagnosis-main-provider-output/1 with variant-aware citation validation."
    },
    {
      "code": "retrieval_and_tool_ledger",
      "status": "pass",
      "evidence": "The outcome-eligible runtime fixes B2 and CodeGraph at two provider turns and FULL at three, restricts retrieval to each request's declared visible corpus, and writes a create-only request/response/selection ledger before and after every turn. Incomplete turns cannot be replayed automatically."
    },
    {
      "code": "finite_census_route_coverage",
      "status": "pass",
      "evidence": "The sealed census and offline preflight account exactly for 32 families, 128 evidence contexts, 1,024 controlled logical requests, 896 provider-backed requests, 128 deterministic B0 requests, and 1,408 provider turns; B3 remains a separate 35-case external-transfer evaluation."
    },
    {
      "code": "non_pooling_boundaries",
      "status": "pass",
      "evidence": "B0, B3, CodeGraph and FULL are separate; Qwen and LogDx are not pooled with GPT-4.1 matched estimates."
    }
  ],
