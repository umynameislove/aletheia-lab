    {"id": "native-single-entry", "family": "native_reentry", "policy": "pin_at_acceptance", "retry": "inherit", "target_entries": 1, "auxiliary_entries": 0, "operations": "accept_A;read_A_once;one_actual_native_entry;close"},
    {"id": "native-same-buffer-reentry", "family": "native_reentry", "policy": "pin_at_acceptance", "retry": "inherit", "target_entries": 2, "auxiliary_entries": 0, "operations": "accept_A;read_A_once;first_native_entry;backend_specific_native_reentry_same_buffer;close_count_2"},
    {"id": "delivery-duplicate-only", "family": "native_reentry", "policy": "pin_at_acceptance", "retry": "inherit", "target_entries": 1, "auxiliary_entries": 0, "operations": "accept_A;one_native_entry;deliver_identical_occurrence_record_twice;deduplicate_by_occurrence_id;close_count_1"},
    {"id": "cache-only-alias-advance", "family": "warm_cache", "policy": "resolve_at_load", "retry": "reselect", "target_entries": 0, "auxiliary_entries": 1, "operations": "warm_parent_with_A;advance_alias_B;serve_cached_object_in_child_without_native_load;close_count_0"},
    {"id": "cache-explicit-reload-current", "family": "warm_cache", "policy": "resolve_at_load", "retry": "reselect", "target_entries": 1, "auxiliary_entries": 1, "operations": "warm_parent_with_A;advance_alias_B;child_resolve_B;read_B;native_load;close"},
    {"id": "cache-reload-stale-buffer", "family": "warm_cache", "policy": "resolve_at_load", "retry": "reselect", "target_entries": 1, "auxiliary_entries": 1, "operations": "warm_parent_with_A;advance_alias_B;child_resolve_B;read_actual_old_A_from_spool;native_load;close"}
